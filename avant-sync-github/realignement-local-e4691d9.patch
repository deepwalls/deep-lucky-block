+            int realDiff2 = measureFlatnessZone(level, c.cx(), c.cz(), checkR);
+            if (realDiff2 < 0 || realDiff2 > maxDiff * 2) continue;
+            int surfY2 = deepluckyblock.util.SafeSurface.surfaceY(level, c.cx(), c.cz(), origin.getY());
