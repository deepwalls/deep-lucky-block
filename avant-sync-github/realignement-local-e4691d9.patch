+        int removed = 0;
+        int thresholdY = min.getY() + 1;
+
+        for (int x = min.getX(); x <= max.getX(); x++) {
+            for (int z = min.getZ(); z <= max.getZ(); z++) {
+                for (int y = level.getMinBuildHeight(); y <= Math.min(max.getY(), thresholdY); y++) {
+                    pos.set(x, y, z);
