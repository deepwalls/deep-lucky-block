+    private static int manishPriced(int baseCount, RandomSource random) {
+        double mult = MANISH_PRICE_MULT_MIN
+                + random.nextFloat() * (MANISH_PRICE_MULT_MAX - MANISH_PRICE_MULT_MIN);
