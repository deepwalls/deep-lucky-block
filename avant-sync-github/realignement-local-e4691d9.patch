+    private static final Set<String> NON_OVERWORLD_FLOWERS = Set.of(
+            "chorus_flower",        // End -- exige de l'end_stone, etat invalide sur l'herbe
+            "chorus_plant",
+            "wither_rose",          // inflige Wither au contact
+            "closed_eyeblossom",    // Pale Garden / Nether
