+        if (lx != 0 || lz != 0) { double dot = (dx * lx + dz * lz) / dist; if (dot > Math.cos(VIEW_CONE / 2)) score += 100 + (int) (dot * 50); else if (dot > 0) score += 30; else score -= 20; }
+        return score;
+    }
