+    private static class PostJob {
+        final ServerLevel level; final BlockPos min, max; final String name; int y;
+        PostJob(ServerLevel l, BlockPos mn, BlockPos mx, String n) { level = l; min = mn; max = mx; name = n; y = mn.getY(); }
