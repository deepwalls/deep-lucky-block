+    private static int computeSmoothRing(BlockPos min, BlockPos max) {
+        int w = max.getX() - min.getX() + 1;
+        int d = max.getZ() - min.getZ() + 1;
+        return Math.max(SMOOTH_RING_MIN, Math.min(SMOOTH_RING_MAX, Math.max(w, d) / 2));
+    }
