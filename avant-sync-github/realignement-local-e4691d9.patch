+    private static boolean isLog(BlockState s) {
+        if (s.is(net.minecraft.tags.BlockTags.LOGS)) return true;
+        initFallbackTreeBlocks();
+        return FALLBACK_LOG_BLOCKS.contains(s.getBlock());
+    }
