+    private static final long PASTE_TICK_BUDGET_MS = 40;
+    private static final int EVEREST_BLOCKS_PER_TICK = 100000;
+    private static final long EVEREST_TICK_TIMEOUT_MS = 90;   // T33 : 300 -> 90 ms
