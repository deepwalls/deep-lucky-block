+    private static boolean isLeaf(BlockState s) {
+        if (s.is(net.minecraft.tags.BlockTags.LEAVES)) return true;
+        initFallbackTreeBlocks();
+        return FALLBACK_LEAF_BLOCKS.contains(s.getBlock());
+    }
