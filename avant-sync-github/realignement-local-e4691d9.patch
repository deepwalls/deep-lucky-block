+        if (b == Blocks.SPRUCE_LOG) return "spruce";
+        if (b == Blocks.JUNGLE_LOG) return "jungle";
+        if (b == Blocks.ACACIA_LOG) return "acacia";
+        if (b == Blocks.DARK_OAK_LOG) return "dark_oak";
+        if (b == Blocks.MANGROVE_LOG) return "mangrove";
