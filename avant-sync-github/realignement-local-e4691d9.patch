+    /**
+     * Nom de la structure en cours, memorise pour que decorate() puisse choisir
+     * le theme du decor sans changer sa signature (appelee depuis plusieurs
+     * procedures).
+     */
+    private static String LAST_STRUCTURE_NAME = null;
+
